# Cluster topology and common paths for GCP 3-node setup.
export MASTER_HOST="hadoop-master"
export WORKERS_ONLY="hadoop-worker-1 hadoop-worker-2"
export WORKERS="hadoop-master hadoop-worker-1 hadoop-worker-2"
export WORKER_SSH_USER="tiennd3886"

export JAVA_HOME="/usr/lib/jvm/java-8-openjdk-amd64"
export HADOOP_HOME="$HOME/hadoop-3.3.6"
export SPARK_HOME="$HOME/spark-3.5.1-bin-hadoop3"
export HADOOP_CONF_DIR="$HADOOP_HOME/etc/hadoop"
